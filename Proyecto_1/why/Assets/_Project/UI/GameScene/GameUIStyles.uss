/* ========================================== */
/* 1. MODALES (Tutorial y Resultados)       */
/* ========================================== */

/* FONDOS OSCUROS */
#TutorialOverlay, #ResultsOverlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85); 
    align-items: center; 
    justify-content: center; 
}

/* CAJAS PRINCIPALES GRISES */
#ModalContainer, #ResultsModal {
    background-color: rgb(203, 201, 190); 
    width: 80%; 
    min-height: 70%; 
    border-radius: 60px;
    padding: 60px; 
    margin: 40px;
    align-items: center; 
}

#ModalContainer {
    justify-content: space-between; 
}

#ResultsModal {
    justify-content: center; /* Centra el texto de victoria/derrota en medio */
}

/* TÍTULOS */
#TutorialTitle {
    font-size: 90px; /* <-- REDUCIDO para que quepa todo */
    color: rgb(59, 61, 63);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    margin-top: 0;
    margin-bottom: 2%; 
}

#ResultTitleLabel {
    font-size: 250px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    margin-bottom: 80px; 
}

/* CAJA DE TEXTO DEL TUTORIAL */
/* --- NUEVO CONTENEDOR SCROLL VIEW --- */
#RulesScrollView {
    width: 100%;
    flex-grow: 1; /* MAGIA: Toma todo el espacio disponible entre el título y el botón */
    margin-top: 2%;
    margin-bottom: 2%;
}

/* --- BLOQUE INDIVIDUAL DE CADA REGLA --- */
.rule-block {
    width: 95%; /* Un poco menos del 100% para dejarle espacio a la barra de scroll */
    margin-bottom: 40px; /* Podemos darle buen espacio de nuevo porque ahora hay scroll */
    align-items: center; 
    flex-shrink: 0; 
}

/* --- SUBTÍTULOS --- */
.rule-subtitle {
    font-size: 50px; 
    color: rgb(59, 61, 63);
    align-self: flex-start;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    margin: 0;
    margin-top: 15px;
    padding: 0;
}

/* --- CUERPO DE TEXTO --- */
.rule-text {
    font-size: 35px; 
    color: rgb(93, 100, 24);
    white-space: normal; 
    max-width: 100%;
    align-self: flex-start;
    -unity-text-align: upper-left;
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    padding: 0;
    margin-bottom: 50px;
    }

/* --- ESTILOS DE LA PANTALLA SIMPLIFICADA DE TUTORIAL --- */
.tutorial-clock-icon {
    width: 250px;
    height: 250px;
    margin-bottom: 45px;
    background-image: url("project://database/Assets/_Project/Art/Sprites/clock.svg");
    -unity-background-scale-mode: scale-to-fit;
}

#TutorialText {
    font-size: 80px;
    color: rgb(59, 61, 63);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    margin-bottom: 40px;
    white-space: normal;
    max-width: 800px;
}

/* BOTONES COMUNES (Mismo estilo que el menú principal) */
#StartLevelButton, #RestartButton, #ResumeButton, #QuitButton, #SettingsButton, #ResultsQuitButton {
    min-width: 400px;
    font-size: 70px;
    color: rgb(255, 255, 255);
    background-color: rgb(162, 17, 83);
    border-color: transparent;
    border-radius: 60px;
    border-width: 0;
    padding-top: 15px;
    padding-bottom: 15px;
    padding-left: 50px;
    padding-right: 50px;
    margin-top: 15px;
    margin-bottom: 15px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    transition-duration: 0.2s;
    transition-property: background-color, scale;
}

#StartLevelButton:hover, #RestartButton:hover, #ResumeButton:hover, #QuitButton:hover, #SettingsButton:hover, #ResultsQuitButton:hover {
    background-color: rgb(69, 7, 36);
    scale: 1.05;
}

#StartLevelButton:active, #RestartButton:active, #ResumeButton:active, #QuitButton:active, #SettingsButton:active, #ResultsQuitButton:active {
    scale: 1.05;
    background-color: rgb(137, 137, 137);
}

/* ========================================== */
/* 2. HUD (Puntos y Vidas)                  */
/* ========================================== */

#HUDContainer {
    position: absolute;
    top: 0; left: 0; right: 0;
    flex-direction: row; 
    justify-content: space-between; 
    padding-top: 40px;
    padding-left: 90px;
    padding-right: 90px;
}

.hud-text {
    font-size: 80px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    text-shadow: 3px 3px 0px rgba(0, 0, 0, 0.7); 
}

/* ========================================== */
/* 3. TEXTO DE COMBO (Animado por CSS)      */
/* ========================================== */

#ComboLabel {
    /* 1. Lo sacamos del flujo de flexbox para que no empuje los otros textos */
    position: absolute;
    
    /* 2. Centrado horizontal exacto (Mitad de 220px) */
    left: 50%;
    margin: 0;
    margin-left: -110px; 
    
    /* 3. Posición vertical fija debajo del HUD */
    top: 140px;
    
    /* 4. Forma y bordes */
    width: 220px; 
    height: 220px; 
    border-radius: 50%; 
    border-color: rgb(255, 255, 255); 
    border-width: 8px; 
    padding: 0;
    
    /* 5. Colores y alineación */
    background-color: rgb(162, 17, 83); /* Tu guinda/magenta */
    -unity-text-align: middle-center;
    
    /* 6. Tipografía */
    font-size: 110px; 
    color: rgb(255, 255, 255); 
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    text-shadow: 5px 5px 0px rgba(0, 0, 0, 0.8);
    
    /* Animación del Pop */
    transition-duration: 0.15s;
    transition-property: scale, color;
}

.combo-pop {
    scale: 1.3;
}

/* ========================================== */
/* 4. GAMEPLAY (Palabra y Temporizador)     */
/* ========================================== */

#GameplayContainer {
    position: absolute;
    width: 100%;
    bottom: 10%; /* Lo subimos un poco más para dar espacio al nuevo fondo */
    align-items: center; 
    justify-content: center;
}

#WordDisplay {
    /* --- ESTILOS DE FUENTE EXISTENTES (CON AJUSTE DE TAMAÑO) --- */
    font-size: 110px; /* Reducido ligeramente de 130px para que quepa bien en la caja */
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    text-shadow: 4px 4px 0px rgba(0, 0, 0, 0.8);
    margin-bottom: 40px; /* Más separación de la barra de tiempo */
    letter-spacing: 3px;
    
    /* --- NUEVOS ESTILOS PARA CREAR EL FONDOS --- */
    
    /* 1. Fondo y Opacidad */
    /* Usamos el color vino de tus modales para consistencia visual */
    background-color:  rgb(59, 61, 63);  
    
    /* 2. Espaciado Interno (Padding) - CRUCIAL para que parezca botón */
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 80px;  /* Mucho espacio a los lados para palabras largas */
    padding-right: 80px;
    
    /* 3. Bordes Redondeados (estilo Apple) */
    border-radius: 40px;
    
    /* 4. Alineación del texto DENTRO de la caja */
    -unity-text-align: middle-center;
    
    /* 6. Un borde sutil opcional para definirlo más */
    border-width: 10px;
    border-color: rgba(255, 255, 255, 0.1); 
}

/* El fondo gris de la barra de tiempo */
#TimerBackground {
    width: 60%; 
    height: 30px;
    background-color: rgb(59, 61, 63); 
    border-radius: 15px;
    overflow: hidden; 
}

/* La barra verde que se va vaciando */
#TimerFill {
    width: 100%; 
    height: 100%;
    background-color: rgb(173, 186, 152); 
    border-radius: 15px;
    border-color: rgb(255, 255, 255); 
    border-width: 4px; 
}

/* ========================================== */
/* 5. ESTILOS DEL SCROLLBAR (Scroll View)     */
/* ========================================== */

/* Ancho general de la barra vertical y margen para separarla del borde */
#RulesScrollView .unity-scroller--vertical {
    width: 18px;
    margin-right: 8px;
}

/* 1. Ocultar las flechitas de arriba y abajo (estilo moderno) */
#RulesScrollView .unity-scroller__low-button,
#RulesScrollView .unity-scroller__high-button {
    display: none;
}

/* 2. El "riel" o fondo de la barra (Tracker) */
#RulesScrollView .unity-base-slider__tracker {
    background-color: rgba(59, 61, 63, 0.15); /* Tu gris oscuro, pero muy transparente */
    border-width: 0; /* Quitamos el borde por defecto de Unity */
    border-radius: 9px; /* Bordes bien redondeados */
}

/* 3. La "pastilla" que el jugador arrastra (Dragger) */
#RulesScrollView .unity-base-slider__dragger {
    background-color: rgb(59, 61, 63); /* Gris oscuro sólido */
    border-width: 0;
    border-radius: 9px;
}

/* 4. Efecto Hover para que se sienta interactivo */
#RulesScrollView .unity-base-slider__dragger:hover {
    background-color: rgb(173, 186, 152); /* Cambia a tu verde militar al pasar el mouse */
}

/* ========================================== */
/* 6. PANTALLA DE PAUSA                       */
/* ========================================== */

/* Fondo oscuro que cubre todo y centra el contenido */
#PauseOverlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.95); 
    align-items: center; 
    justify-content: center; 
    /* display: none; <-- Descomenta esto después de estilizar en UI Builder para ocultarlo por defecto */
}

/* El título de "PAUSA" */
#PauseTitle {
    font-size: 150px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    margin-bottom: 80px; /* Da un buen espacio antes de los botones */
    text-shadow: 5px 5px 0px rgba(0, 0, 0, 0.8);
}

/* Los botones ahora comparten estilo con #StartLevelButton arriba */

/* ========================================== */
/* HIGH SCORE ENTRY                           */
/* ========================================== */

#HighScoreContainer {
    align-items: center;
    justify-content: center;
    background-color: rgba(59, 61, 63, 0.15);
    border-radius: 30px;
    padding: 25px;
    width: 80%;
    margin-bottom: 30px;
}

#HighScoreNameInput {
    border-width: 0;
    padding: 0;
    margin: 0;
    margin-bottom: 15px;
    height: 60px;
    width: 400px;
}

#HighScoreNameInput .unity-text-field__input {
    background-color: rgb(255, 255, 255);
    color: rgb(59, 61, 63);
    border-color: rgb(59, 61, 63);
    border-width: 3px;
    border-radius: 15px;
    padding: 0 15px;
    margin: 0;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    font-size: 35px;
    height: 100%;
}

#HighScoreNameInput .unity-text-field__placeholder {
    color: rgba(59, 61, 63, 0.4);
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    font-size: 35px;
    padding: 0 15px;
}

#SubmitHighScoreButton {
    width: 250px;
    min-width: 250px;
    height: 50px;
    font-size: 32px;
    border-radius: 15px;
    margin: 0;
    margin-top: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgb(20, 20, 20);
    color: rgb(255, 255, 255);
    border-width: 0;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    transition-duration: 0.2s;
    transition-property: background-color, scale;
}

#SubmitHighScoreButton:hover {
    background-color: rgb(50, 50, 50);
    scale: 1.05;
}

#SubmitHighScoreButton:active {
    background-color: rgb(80, 80, 80);
    scale: 0.98;
}