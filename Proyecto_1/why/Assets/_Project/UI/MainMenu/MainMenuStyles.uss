.apple-button {
    background-image: none;
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    font-size: 70px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    background-color: rgb(162, 17, 83);
    border-color: transparent;
    border-radius: 60px;
    padding-top: 15px;
    padding-bottom: 15px;
    padding-left: 50px;
    padding-right: 50px;
    -unity-text-align: middle-center;
    margin-top: 15px;
    margin-bottom: 15px;
    transition-duration: 0.2s;
    transition-property: background-color, scale;
    min-width: 400px;
    min-height: 150px;
}

.apple-button:hover {
    background-color:rgb(69, 7, 36);
    scale: 1.05;
}

.apple-button:active {
    scale: 1.05;
    background-color: rgb(137, 137, 137);
}

/* ========================================== */
/* MODAL DE SELECCIÓN DE MODO                 */
/* ========================================== */

.mode-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    transition-duration: 0.3s;
    transition-property: opacity;
}

.mode-modal {
    background-color: rgb(203, 201, 190);
    width: 60%;
    min-height: 50%;
    border-radius: 60px;
    padding: 60px;
    align-items: center;
    justify-content: center;
}

.mode-title {
    font-size: 120px;
    color: rgb(59, 61, 63);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    margin-bottom: 40px;
}

.mode-back-button {
    background-image: none;
    -unity-font-definition: url("project://database/Assets/BebasNeue-Regular.ttf?fileID=12800000&guid=faf509b83ba24ba4c8d5dc75f1154afd&type=3#BebasNeue-Regular");
    font-size: 50px;
    color: rgb(59, 61, 63);
    -unity-font-style: bold;
    background-color: transparent;
    border-color: rgb(59, 61, 63);
    border-width: 4px;
    border-radius: 40px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 40px;
    padding-right: 40px;
    -unity-text-align: middle-center;
    margin-top: 30px;
    transition-duration: 0.2s;
    transition-property: background-color, color, scale;
}

.mode-back-button:hover {
    background-color: rgb(59, 61, 63);
    color: rgb(255, 255, 255);
    scale: 1.05;
}
